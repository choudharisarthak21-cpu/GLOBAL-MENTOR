# Global Mentor Environment Configuration Template
# Duplicate this file to .env for local overrides

# App URL
VITE_APP_URL=http://localhost:5173

# Backend API Base URL (Point to your production or local API server)
# VITE_API_BASE_URL=https://api.globalmentor.example/v1

# Video Consultation Provider Key (e.g. Daily.co, Twilio Video, or WebRTC token)
# VITE_DAILY_API_KEY=

# Analytics & Monitoring (Optional)
# VITE_SENTRY_DSN=
